#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

VENV=.venv
INDEX=index.html

# --- ensure Python + deps ---
if [ ! -f "$VENV/bin/python3" ]; then
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install markdown --quiet
fi
PY="$VENV/bin/python3"

# --- build ---
case "${1:-}" in
    --serve)
        "$PY" generate.py --serve
        ;;
    --no-open)
        "$PY" generate.py --no-open
        ;;
    *)
        "$PY" generate.py
        if [ -f "$INDEX" ]; then
            if command -v xdg-open &>/dev/null; then
                xdg-open "$INDEX" &
            elif command -v open &>/dev/null; then
                open "$INDEX" &
            fi
        fi
        ;;
esac
