# ─── Cluster paths ───────────────────────────────────────────────────
# This file is read by slurm/load_cluster_env.sh.
#
# The canonical copy on the cluster is ~/.bench.env (created once by the
# reproducer, never touched by git pull).  The .env file at the repo root
# is kept for convenience but is optional.
#
# Required variables:
#   REPO_ROOT  — absolute path to your bench-transformer-cell-tracking checkout
#   TRK        — absolute path to your trackastra checkout
#   BENCH      — same as REPO_ROOT (kept for backwards compat)
#   DATA_DIR   — root of cell-tracking data on the cluster

# Benchmark repo checkout (this repo).
REPO_ROOT=/path/to/bench-transformer-cell-tracking

# Trackastra checkout (the source tree, not the installed package).
TRK=/path/to/trackastra

# Alias for REPO_ROOT, kept for backwards compat with scripts that
# reference $BENCH/benchmark_*.
BENCH=/path/to/bench-transformer-cell-tracking

# Root of cell-tracking data on the cluster.
DATA_DIR=/path/to/celltracking/data
